# SPA fallback for Apache (Hostinger shared hosting, etc.)
# Vite copies this file to dist/ on build — upload dist including .htaccess
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leftover mass district×model URLs → district hub (301)
  RewriteRule ^(araria|arwal|aurangabad|banka|begusarai|bhagalpur|bhojpur|buxar|darbhanga|east-champaran|gaya|gopalganj|jamui|jehanabad|kaimur|katihar|khagaria|kishanganj|lakhisarai|madhepura|madhubani|munger|muzaffarpur|nalanda|nawada|patna|purnia|rohtas|saharsa|samastipur|saran|sheikhpura|sheohar|sitamarhi|siwan|supaul|vaishali|west-champaran)/(vinfast-mpv7|vinfast-limo-green)/?$ /$1 [R=301,L]
  RewriteRule ^(araria|arwal|aurangabad|banka|bhojpur|buxar|gopalganj|jamui|jehanabad|kaimur|katihar|khagaria|kishanganj|lakhisarai|madhepura|madhubani|munger|nawada|saharsa|samastipur|sheikhpura|sheohar|sitamarhi|siwan|supaul|west-champaran)/(vinfast-vf6|vinfast-vf7)/?$ /$1 [R=301,L]

  # Retired thin blog slugs
  RewriteRule ^blogs/why-electric-vehicles-are-the-future-of-bihar/?$ /blogs/electric-suv-buying-checklist-bihar [R=301,L]
  RewriteRule ^blogs/how-to-choose-the-right-electric-suv/?$ /blogs/electric-suv-buying-checklist-bihar [R=301,L]
  RewriteRule ^blogs/charging-infrastructure-in-bihar/?$ /blogs/home-ev-charging-bihar [R=301,L]
  RewriteRule ^blogs/cost-of-owning-an-ev/?$ /blogs/ev-running-cost-bihar [R=301,L]
  RewriteRule ^blogs/top-10-reasons-to-buy-the-vf6/?$ /blogs/vf6-ownership-guide-bihar [R=301,L]
  RewriteRule ^blogs/is-the-vf6-worth-buying/?$ /blogs/vf6-vs-vf7-bihar [R=301,L]
  RewriteRule ^blogs/vf6-running-cost-analysis/?$ /blogs/ev-running-cost-bihar [R=301,L]
  RewriteRule ^blogs/why-the-vf7-stands-out/?$ /blogs/vf7-highway-guide-bihar [R=301,L]
  RewriteRule ^blogs/adas-explained/?$ /blogs/vf7-highway-guide-bihar [R=301,L]
  RewriteRule ^blogs/best-electric-mpv-in-india/?$ /blogs/7-seater-ev-bihar [R=301,L]
  RewriteRule ^blogs/family-road-trips-with-mpv7/?$ /blogs/7-seater-ev-bihar [R=301,L]
  RewriteRule ^blogs/corporate-fleet-benefits-electric-mpv/?$ /blogs/7-seater-ev-bihar [R=301,L]

  # Dynamic SEO files from API (Google follows the redirect for sitemap)
  RewriteRule ^sitemap\.xml$ https://apivnfast.patliputragroup.com/api/v1/sitemap.xml [R=302,L]
  RewriteRule ^api/v1/sitemap\.xml$ https://apivnfast.patliputragroup.com/api/v1/sitemap.xml [R=302,L]

  # Don't rewrite real files or directories (robots.txt + llms.txt are static in /public)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Serve index.html for client-side routes (React Router)
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: single-page caching — HTML always revalidated
<FilesMatch "index\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>
