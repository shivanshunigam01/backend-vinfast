# Copy to `.env`, `.env.development`, or `.env.production` as needed.

# Live backend (default). For local backend use: http://localhost:2000/api/v1
VITE_API_URL=https://apivnfast.patliputragroup.com/api/v1
VITE_PUBLIC_FORM_POST_DISABLED=false

# Optional — pair with backend RECAPTCHA_SECRET_KEY
VITE_RECAPTCHA_SITE_KEY=

# Optional — same Cloudinary cloud as backend; unsigned upload preset from Cloudinary console
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
